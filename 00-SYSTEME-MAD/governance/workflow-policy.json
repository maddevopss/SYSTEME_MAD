{
  "version": 1,
  "required_global_keys": ["permissions:", "concurrency:"],
  "required_job_keys": ["runs-on:", "timeout-minutes:"],
  "write_permission_allowlist": [
    ".github/workflows/governance-dashboard.yml",
    ".github/workflows/documentation-dashboard.yml"
  ],
  "maximum_timeout_minutes": 30,
  "forbidden_permissions": [
    "actions: write",
    "checks: write",
    "deployments: write",
    "id-token: write",
    "packages: write",
    "security-events: write",
    "statuses: write"
  ],
  "automation_workflows": [
    ".github/workflows/governance-dashboard.yml",
    ".github/workflows/documentation-dashboard.yml"
  ]
}
